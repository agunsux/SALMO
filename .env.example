# SALMO.DEV — Canonical Environment Configuration
# Copy this file to .env.local for local development.
# NEVER commit real secrets or .env.local to version control.

# ==============================================================================
# 1. APPLICATION & ROUTING
# ==============================================================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
SALMO_API_URL=http://localhost:3000/api

# ==============================================================================
# 2. HANDICAPLAB BACKEND CONTRACT ADAPTER
# ==============================================================================
# 'local' reads sibling directory in dev; 'http' queries HandicapLab REST API in production.
HANDICAPLAB_ADAPTER=local
# Local development path override (optional; defaults to ../HandicapLab/data/bronze/football_data)
HANDICAPLAB_DATA_PATH=../HandicapLab/data/bronze/football_data
# Production API URL for HandicapLab Contract Service (required when HANDICAPLAB_ADAPTER=http)
HANDICAPLAB_API_URL=https://handicaplab.dev/api/v1/contract
HANDICAPLAB_API_KEY=

# ==============================================================================
# 3. DATABASE (POSTGRESQL / SUPABASE)
# ==============================================================================
# Leave empty if running in stateless local mode; required for persistent production
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# 4. LIVE FOOTBALL & MARKET PROVIDERS
# ==============================================================================
# API-Football (RapidAPI or direct API-Sports)
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# OddsPapi (Asian Handicap & 1X2 Market Feeds)
ODDS_PAPI_KEY=
ODDS_PAPI_BASE_URL=https://api.oddspapi.com/v1

# ==============================================================================
# 5. SECURITY, CRON & AUTHENTICATION
# ==============================================================================
AUTH_SECRET=
CRON_SECRET=

# ==============================================================================
# 6. OBSERVABILITY & LOGGING
# ==============================================================================
LOG_LEVEL=info

